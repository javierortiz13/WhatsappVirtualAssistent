# ---- Base de datos (Supabase Pro, proyecto propio). Usar el SESSION pooler (puerto 5432), no el
# transaction pooler (6543). Donde: Supabase -> Project Settings -> Database -> Connection string.
# Rol de la aplicacion (sujeto a RLS). Se crea en la migracion; el LOGIN se da a mano (docs/runbooks/s0-cuentas.md).
DATABASE_URL=postgres://caja_app.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# CA de Supabase para verificar TLS de verdad. Donde: Project Settings -> Database -> SSL configuration
# -> Download certificate. Guardalo en certs/ (ignorado por git). En Railway/Vercel usa DATABASE_SSL_CA con el PEM.
DATABASE_SSL_CA_PATH=./certs/supabase-ca.crt
# Rol con permisos de migracion (owner del schema app). Solo lo usa `pnpm db:migrate`.
DATABASE_ADMIN_URL=postgres://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# ---- Seed (solo desarrollo y piloto). Numeros en formato E.164 sin '+'.
SEED_OWNER_PHONE=58412XXXXXXX
SEED_OWNER_EMAIL=dueno@ejemplo.com
SEED_SECOND_TENANT_PHONE=58414XXXXXXX
SEED_SECOND_TENANT_EMAIL=segundo@ejemplo.com

# ---- Meta WhatsApp Cloud API (dia 2). Donde: developers.facebook.com -> tu app -> WhatsApp -> API Setup
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_GRAPH_VERSION=v24.0

# ---- LLM (dia 5). Donde: console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
LLM_PRIMARY=anthropic:claude-sonnet-5-5
# Caché del prompt: 1h por defecto (mensajes espaciados); 5m si el tráfico es continuo.
# LLM_CACHE_TTL=1h

# ---- Voz a texto (US-B5). Donde: console.deepgram.com -> API Keys. Solo el worker (Railway).
DEEPGRAM_API_KEY=
# Idioma para Nova-3; "es" por defecto. Si Deepgram admite "es-419" en el modelo, usar ese.
# DEEPGRAM_LANGUAGE=es

# ---- Correo (dia 6). Donde: resend.com -> API Keys
RESEND_API_KEY=

# ---- Observabilidad
SENTRY_DSN=
LOG_LEVEL=info

# ---- Producto
ASSISTANT_NAME=Asistente de Caja
DASHBOARD_URL=http://localhost:3000
# Numero de WhatsApp de la plataforma (E.164 sin '+'), para el boton "Abrir WhatsApp" del registro.
# Donde: Meta -> WhatsApp -> API Setup -> numero de telefono. Solo lo usa el dashboard (Vercel).
PLATFORM_WA_NUMBER=
# Panel /admin (web, Vercel): correos con acceso, separados por coma. Sin esto nadie entra.
PLATFORM_ADMIN_EMAILS=
# Datos de cobro que ve el cliente en Ajustes → Mi plan (web, Vercel). Texto libre.
# Datos de cobro: en Vercel (página "Mi plan") y en Railway (renovar por el bot, 03/10).
# PAYMENT_PAGO_MOVIL="Banco · teléfono · cédula"
# PAYMENT_ZELLE="correo@ejemplo.com · Nombre Apellido"
# PAYMENT_BINANCE="Binance ID o correo"
# SUPPORT_HINT="WhatsApp +58 412 0000000"
# Tarifa de Meta por mensaje de servicio fuera del cupo gratis (web y pnpm metrics).
# META_MSG_RATE_USD=0.0113
CURRENCY_VES_THRESHOLD=1000
# Tarifa de Meta por mensaje de servicio (USD) para el estimado de `pnpm metrics`. Venezuela = "Rest of Latin America".
# META_MSG_RATE_USD=0.013

# Evals del agente (pnpm evals): solo corren con RUN_EVALS=1 y ANTHROPIC_API_KEY.
# EVALS_MAX_USD=0.50
# EVALS_MODEL=claude-sonnet-5-5

# Dashboard (día 6): Supabase Auth (Project Settings → API) y Sentry (opcional).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Entrar con Google: proveedor Google activo en Supabase (Authentication -> Providers) con el
# client ID/secret de Google Cloud puestos ALLÍ, no aquí. Luego GOOGLE_AUTH_ENABLED=1 en Vercel.
# GOOGLE_AUTH_ENABLED=0

# ---- Fotos de facturas (US-B6): bucket privado `receipts` en Supabase Storage.
# Donde: Supabase -> Storage -> New bucket "receipts" (privado); Project Settings -> API -> service_role.
# Worker (Railway): SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY. Web (Vercel): solo SUPABASE_SERVICE_ROLE_KEY
# (la URL sale de NEXT_PUBLIC_SUPABASE_URL). La service_role jamas va al navegador ni al repo.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=receipts
# SENTRY_DSN=            (servidor: worker en Railway y Next en Vercel)
# NEXT_PUBLIC_SENTRY_DSN=  (navegador)
# SENTRY_ORG= SENTRY_PROJECT= SENTRY_AUTH_TOKEN=  (solo Vercel, para subir source maps en el build; opcional)
