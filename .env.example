# ---- Base de datos (Supabase Pro, proyecto propio). Usar el SESSION pooler (puerto 5432), no el
# transaction pooler (6543). Donde: Supabase -> Project Settings -> Database -> Connection string.
# Rol de la aplicacion (sujeto a RLS). Se crea en la migracion; el LOGIN se da a mano (docs/runbooks/s0-cuentas.md).
DATABASE_URL=postgres://caja_app.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# CA de Supabase para verificar TLS de verdad. Donde: Project Settings -> Database -> SSL configuration
# -> Download certificate. Guardalo en certs/ (ignorado por git). En Railway/Vercel usa DATABASE_SSL_CA con el PEM.
DATABASE_SSL_CA_PATH=./certs/supabase-ca.crt
# Rol con permisos de migracion (owner del schema app). Solo lo usa `pnpm db:migrate`.
DATABASE_ADMIN_URL=postgres://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# ---- Seed (solo desarrollo y piloto). Numeros en formato E.164 sin '+'.
SEED_OWNER_PHONE=58412XXXXXXX
SEED_OWNER_EMAIL=dueno@ejemplo.com
SEED_SECOND_TENANT_PHONE=58414XXXXXXX
SEED_SECOND_TENANT_EMAIL=segundo@ejemplo.com

# ---- Meta WhatsApp Cloud API (dia 2). Donde: developers.facebook.com -> tu app -> WhatsApp -> API Setup
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_GRAPH_VERSION=v24.0

# ---- LLM (dia 5). Donde: console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
LLM_PRIMARY=anthropic:claude-sonnet-5-5

# ---- Voz a texto (S4). Donde: console.deepgram.com
DEEPGRAM_API_KEY=

# ---- Correo (dia 6). Donde: resend.com -> API Keys
RESEND_API_KEY=

# ---- Observabilidad
SENTRY_DSN=
LOG_LEVEL=info

# ---- Producto
ASSISTANT_NAME=Asistente de Caja
DASHBOARD_URL=http://localhost:3000
CURRENCY_VES_THRESHOLD=1000
