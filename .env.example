# ---- Base de datos (Supabase Pro, proyecto propio). Conexion directa, no el pooler en modo transaccion.
# Donde: Supabase -> Project Settings -> Database -> Connection string (URI), con sslmode=require
DATABASE_URL=postgres://caja_app:password@db.xxxx.supabase.co:5432/postgres?sslmode=require
# Rol con permisos de migracion (owner del schema app). Solo lo usa `pnpm db:migrate`.
DATABASE_ADMIN_URL=postgres://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require

# ---- Seed (solo desarrollo y piloto). Numeros en formato E.164 sin '+'.
SEED_OWNER_PHONE=58412XXXXXXX
SEED_OWNER_EMAIL=dueno@ejemplo.com
SEED_SECOND_TENANT_PHONE=58414XXXXXXX
SEED_SECOND_TENANT_EMAIL=segundo@ejemplo.com

# ---- Meta WhatsApp Cloud API (dia 2). Donde: developers.facebook.com -> tu app -> WhatsApp -> API Setup
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v24.0

# ---- LLM (dia 5). Donde: console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
LLM_PRIMARY=anthropic:claude-sonnet-5-5

# ---- Voz a texto (S4). Donde: console.deepgram.com
DEEPGRAM_API_KEY=

# ---- Observabilidad
SENTRY_DSN=
LOG_LEVEL=info

# ---- Producto
ASSISTANT_NAME=Asistente de Caja
DASHBOARD_URL=http://localhost:3000
CURRENCY_VES_THRESHOLD=1000
